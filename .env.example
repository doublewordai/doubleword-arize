# ----- Doubleword (the only inference key you need) -----
# One key covers realtime, async, and batch. Get one at https://app.doubleword.ai
DOUBLEWORD_API_KEY=dw-...
DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1

# Models. Pick from https://docs.doubleword.ai/inference-api/model-pricing
# Defaults to the same strong model for generation and judging — batch pricing
# is what makes running a top-tier model as judge cheap.
MODEL_CHAT=deepseek-ai/DeepSeek-V4-Pro
MODEL_JUDGE=deepseek-ai/DeepSeek-V4-Pro

# Concurrency cap for the in-process hero script (eval.py) only.
MAX_CONCURRENCY=8

# ----- Arize Phoenix (local, via docker compose) -----
PROJECT_NAME=doubleword-arize
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ----- Batch completion window -----
# This is the *maximum* time the batch may take (an SLA ceiling), NOT how long
# you wait. In practice batches usually finish in minutes; the long windows
# exist so the shared queue can guarantee a worst case across many tenants.
#   24h  - cheapest (recommended; you rarely wait anywhere near this)
#   1h   - express lane, handy for smoke-testing
BATCH_COMPLETION_WINDOW=24h
