# ----- Doubleword (only inference key you need) -----
DOUBLEWORD_API_KEY=dw-...
DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1

# Which Doubleword tier the example entry-points use.
# realtime  - openai.AsyncOpenAI                (hot path, full price)
# async     - autobatcher.AsyncOpenAI           (~50% off realtime, background jobs)
# batch     - autobatcher.BatchOpenAI           (~90% off realtime, up to 24h)
MODE=realtime

# Models. Pick from https://docs.doubleword.ai/inference-api/model-pricing
MODEL_CHAT=deepseek-ai/DeepSeek-V4-Pro
MODEL_JUDGE=Qwen/Qwen3.5-9B

# Concurrency cap for the async eval loop (semaphore size).
MAX_CONCURRENCY=8

# ----- Observability -----
PROJECT_NAME=doubleword-pydantic

# Local Phoenix (Docker) — http://localhost:6006
PHOENIX_COLLECTOR_ENDPOINT=http://localhost:6006

# ----- Batch eval SLA (only used by examples/run_batch_evals.py) -----
# 24h  - cheapest
# 1h   - express, useful for smoke-testing the batch lane in CI/dev
BATCH_COMPLETION_WINDOW=24h
