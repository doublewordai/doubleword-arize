# ----- Doubleword (the only inference key you need) -----
# Get a key: https://app.doubleword.ai
DOUBLEWORD_API_KEY=dw-...
DOUBLEWORD_BASE_URL=https://api.doubleword.ai/v1

# Models: https://docs.doubleword.ai/inference-api/model-pricing
MODEL_CHAT=deepseek-ai/DeepSeek-V4-Pro
MODEL_JUDGE=deepseek-ai/DeepSeek-V4-Pro

# Concurrency cap for eval.py.
MAX_CONCURRENCY=8

# ----- Arize AX (hosted) -----
# Space ID + API key from Settings in the Arize app: https://app.arize.com
ARIZE_SPACE_ID=...
ARIZE_API_KEY=...
ARIZE_PROJECT_NAME=doubleword-arize

# Longer OTLP export timeout (ms) so root spans land reliably on slow/large batches.
OTEL_EXPORTER_OTLP_TRACES_TIMEOUT=30000

# Using open-source Arize Phoenix instead? See .env.phoenix.example

BATCH_COMPLETION_WINDOW=24h
